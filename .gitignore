# --- Node/依赖包 ---
node_modules/
.npm
package-lock.json.backup
yarn.lock.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 构建产物 ---
dist/
dist-electron/
dist-electron-*/
release/
.electron-builder-cache/
*.tsbuildinfo

# --- 环境变量 (非常重要) ---
.env
.env.local
.env.*.local
RAG-AIAgent/.env

# --- Python 后端 ---
RAG-AIAgent/__pycache__/
RAG-AIAgent/**/__pycache__/
RAG-AIAgent/**/*.pyc
RAG-AIAgent/.venv/
RAG-AIAgent/venv/

# --- 后端运行时数据（含用户文档 + KB 元数据，不入库） ---
RAG-AIAgent/data/kb_registry.json
RAG-AIAgent/data/*/
!RAG-AIAgent/data/.gitkeep

# --- 编辑器与系统文件 ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.vs/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 开发调试临时文件 ---
*_enter.*
*_test.*
*_state.*
fix_test.*
debug.png
PROGRESS.json

# --- 本地打包核验与解包缓存 ---
.*-package/
.package-*-check/
.target-package-check/
.delete-archive-test/
assets/
/icon-180.png
/icon-192.png
/icon-512.png
/icon.svg
/manifest.json
